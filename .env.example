# Nunca coloque valores reais neste arquivo versionado.
# Gere o token aleatório localmente conforme README.md. Não há valor padrão.
# Usado apenas para criar o primeiro administrador; não redefine credenciais.
# Após a criação e guarda segura da credencial, pode ficar vazio.
# Sem administrador ativo na primeira instalação, vazio impede a inicialização.
APP_BOOTSTRAP_ADMIN_TOKEN=
APP_BOOTSTRAP_ADMIN_USERNAME=bootstrap-admin
OPENAI_API_KEY=
DATABASE_PASSWORD=
